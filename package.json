{
  "name": "healthheart-leadlessguard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "npm --prefix server run dev",
    "build": "tsc && vite build && npm --prefix server run build",
    "start": "node server/dist/server.js",
    "postinstall": "npm --prefix server ci",
    "preview": "vite preview",
    "server:install": "npm --prefix server install",
    "install:all": "npm install && npm --prefix server install"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
